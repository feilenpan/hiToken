.page {
  background: #FAFAFA;
  min-height: 100vh;
  padding: 0 32rpx;
}
.page-header {
  padding: 40rpx 0 24rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.content-scroll {
  height: calc(100vh - 120rpx);
}
.content {
  padding-bottom: 60rpx;
}
.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
