.page { background: #FAFAFA; min-height: 100vh; padding: 0 32rpx; }
.page-header { padding: 40rpx 0 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #1a1a1a; }
.loading-state { text-align: center; padding: 120rpx 0; }
.loading-text { font-size: 28rpx; color: #999; }
.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #999; display: block; margin-bottom: 40rpx; }
.btn-goto { display: inline-block; background: #FF6B35; color: #fff; font-size: 28rpx; padding: 16rpx 48rpx; border-radius: 40rpx; border: none; }
.btn-goto::after { border: none; }
.records-list { padding-bottom: 40rpx; }
.record-card { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.record-thumb { width: 120rpx; height: 120rpx; border-radius: 16rpx; overflow: hidden; flex-shrink: 0; background: #f5f5f5; }
.thumb-img { width: 100%; height: 100%; }
.record-thumb.placeholder { display: flex; align-items: center; justify-content: center; }
.placeholder-icon { font-size: 48rpx; }
.record-info { flex: 1; margin-left: 24rpx; }
.record-title-row { display: flex; align-items: center; gap: 8rpx; }
.record-type-badge { font-size: 28rpx; }
.record-name { font-size: 28rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 300rpx; }
.record-time { font-size: 24rpx; color: #999; display: block; margin-top: 8rpx; }
.record-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.record-type-tag { font-size: 22rpx; color: #FF6B35; background: #FFF5F0; padding: 4rpx 16rpx; border-radius: 20rpx; }
.record-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.record-status.success { color: #52c41a; background: #f6ffed; }
.record-status.fail { color: #ff4d4f; background: #fff2f0; }
.record-arrow { font-size: 40rpx; color: #ccc; flex-shrink: 0; }
