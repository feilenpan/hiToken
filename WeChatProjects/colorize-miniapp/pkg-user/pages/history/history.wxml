<!-- pages/history/history.wxml -->
<view class="page">
  <view class="page-header">
    <text class="page-title">处理记录</text>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty-state" wx:elif="{{isEmpty}}">
    <text class="empty-icon">📷</text>
    <text class="empty-text">还没有处理记录</text>
    <button class="btn-goto" bindtap="goHome">去处理</button>
  </view>

  <view class="records-list" wx:else>
    <view 
      class="record-card" 
      wx:for="{{records}}" 
      wx:key="id"
      bindtap="viewRecord"
      data-index="{{index}}"
    >
      <view class="record-thumb" wx:if="{{item.result_url}}">
        <image src="{{item.result_url}}" mode="aspectFill" class="thumb-img" lazy-load></image>
      </view>
      <view class="record-thumb placeholder" wx:else>
        <text class="placeholder-icon">🎨</text>
      </view>
      <view class="record-info">
        <view class="record-title-row">
          <text class="record-type-badge">{{item.typeIcon}}</text>
          <text class="record-name">{{item.original_filename || '照片处理'}}</text>
        </view>
        <text class="record-time">{{item.timeStr}}</text>
        <view class="record-meta">
          <text class="record-type-tag">{{item.typeName}}</text>
          <text class="record-status {{item.status === 'completed' ? 'success' : 'fail'}}">
            {{item.status === 'completed' ? '完成' : '失败'}}
          </text>
        </view>
      </view>
      <text class="record-arrow">›</text>
    </view>
  </view>
</view>
