/* pages/profile/profile.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 32rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 48rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.user-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 每日配额卡片 */
.quota-card {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F65 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.25);
}
.quota-header {
  margin-bottom: 24rpx;
}
.quota-title {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}
.quota-grid {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 20rpx;
}
.quota-item {
  text-align: center;
}
.quota-value {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-bottom: 8rpx;
}
.quota-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
.quota-divider {
  width: 2rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.3);
}
.quota-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* 套餐（预留） */
.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.packages {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.package {
  flex: 1;
  position: relative;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s;
}

.package.active {
  border-color: var(--primary);
  background: #FFF5F0;
}

.package.featured {
  border-color: var(--primary);
}

.package-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.package-count {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.package-price {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 4rpx;
}

.package-unit {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 分享卡片 */
.share-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFF5F0;
  border-radius: var(--radius);
}

.share-icon {
  font-size: 40rpx;
}

.share-info {
  flex: 1;
}

.share-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.share-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 设置列表 */
.setting-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-text {
  font-size: 30rpx;
  color: #333;
}

.setting-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 客服 */
.support-link {
  text-align: center;
  padding: 48rpx 0;
}

.support-text {
  font-size: 26rpx;
  color: var(--text-muted);
}
