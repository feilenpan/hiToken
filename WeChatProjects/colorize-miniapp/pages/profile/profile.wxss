/* pages/profile/profile.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 32rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

/* Avatar 按钮 — 使用 chooseAvatar */
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #F0F0F0;
  border: 4rpx solid #E8E8E8;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
  line-height: 1;
}
.avatar-btn::after {
  border: none; /* 去掉 button 默认边框 */
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 默认状态下的编辑提示 */
.avatar-edit-hint {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.03);
  border-radius: 50%;
}
.avatar-edit-icon {
  font-size: 36rpx;
  opacity: 0.4;
}

.user-info {
  flex: 1;
  min-width: 0;
}

/* nickname input — type="nickname" */
.nickname-input {
  display: block;
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 8rpx 0;
  background: transparent;
  border: none;
  border-bottom: 2rpx solid transparent;
  transition: border-color 0.2s;
}
.nickname-input:focus {
  border-bottom-color: #FF6B35;
}

.user-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* 每日配额卡片 */
.quota-card {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F65 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.25);
}
.quota-header {
  margin-bottom: 24rpx;
}
.quota-title {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}
.quota-grid {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 20rpx;
}
.quota-item {
  text-align: center;
}
.quota-value {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-bottom: 8rpx;
}
.quota-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
.quota-divider {
  width: 2rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.3);
}
.quota-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* 分享卡片 */
.share-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFF5F0;
  border-radius: var(--radius);
  margin-bottom: 32rpx;
}

.share-icon {
  font-size: 40rpx;
}

.share-info {
  flex: 1;
}

.share-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.share-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 设置列表 */
.setting-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 32rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-text {
  font-size: 30rpx;
  color: #333;
}

.setting-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 客服 */
.support-link {
  text-align: center;
  padding: 48rpx 0;
}

.support-text {
  font-size: 26rpx;
  color: var(--text-muted);
}
