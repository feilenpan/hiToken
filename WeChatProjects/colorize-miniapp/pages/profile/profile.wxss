/* pages/profile/profile.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 用户卡片 — 居中 */
.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
}

/* Avatar — 顶部居中大圆 */
.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0 0 20rpx 0;
  border-radius: 50%;
  background: #F0F0F0;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}
.avatar-btn::after { border: none; }

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 相机提示 */
.avatar-edit-hint {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.avatar-edit-icon {
  font-size: 36rpx;
  opacity: 0.25;
}

/* 昵称 */
.nickname-input {
  width: auto;
  max-width: 400rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  text-align: center;
  padding: 8rpx 16rpx;
  background: transparent;
  border: none;
  border-bottom: 2rpx solid transparent;
  margin-bottom: 8rpx;
}
.nickname-input:focus {
  border-bottom-color: #FF6B35;
}

.user-desc {
  font-size: 24rpx;
  color: #999;
}

/* 每日配额卡片 */
.quota-card {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F65 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.25);
}
.quota-header { margin-bottom: 24rpx; }
.quota-title {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}
.quota-grid {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 20rpx;
}
.quota-item { text-align: center; }
.quota-value {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-bottom: 8rpx;
}
.quota-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
.quota-divider {
  width: 2rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.3);
}
.quota-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* 分享卡片 */
.share-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFF5F0;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}
.share-icon { font-size: 40rpx; }
.share-info { flex: 1; }
.share-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}
.share-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 设置列表 */
.setting-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 32rpx;
}
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.setting-item:last-child { border-bottom: none; }
.setting-text {
  font-size: 28rpx;
  color: #333;
}
.setting-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 客服 */
.support-link {
  text-align: center;
  padding: 48rpx 0;
}
.support-text {
  font-size: 26rpx;
  color: #999;
}
