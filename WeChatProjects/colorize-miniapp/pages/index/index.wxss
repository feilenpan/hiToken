/* pages/index/index.wxss - 方案A 极简主义 */

/* 隐私弹窗 */
.privacy-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; }
.privacy-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); }
.privacy-card { position: relative; background: #fff; border-radius: 24rpx; width: 620rpx; padding: 48rpx 40rpx 40rpx; text-align: center; box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.15); }
.privacy-title { font-size: 36rpx; font-weight: 700; color: #333; margin-bottom: 24rpx; }
.privacy-body { font-size: 28rpx; color: #666; line-height: 1.7; margin-bottom: 36rpx; text-align: left; }
.privacy-btn-link { background: transparent; border: none; color: #FF6B35; font-size: 26rpx; padding: 12rpx 0; margin-bottom: 20rpx; }
.privacy-btn-link::after { border: none; }
.privacy-btn-agree { width: 100%; height: 88rpx; line-height: 88rpx; background: linear-gradient(135deg, #FF6B35, #FF8F65); color: #fff; font-size: 32rpx; font-weight: 600; border-radius: 44rpx; border: none; }
.privacy-btn-agree::after { border: none; }

/* 页面基础 */
.page {
  background: #FAFAFA;
  min-height: 100vh;
}

/* ========== 效果展示区 ========== */
.hero-section {
  position: relative;
  height: 960rpx;
  overflow: hidden;
  padding: 0 24rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

/* ========== 内容区 ========== */
.content-section {
  padding: 48rpx 40rpx;
}

/* 功能标题 */
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.section-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

/* ========== 超大 CTA 按钮 ========== */
.cta-button {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F60 100%);
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 53, 0.4);
  margin-bottom: 24rpx;
}

.cta-icon {
  font-size: 40rpx;
}

.cta-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* 次要说明 */
.secondary-text {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

/* ========== 底部协议入口 ========== */
.legal-links {
  text-align: center;
  padding: 32rpx 0 60rpx;
}

.legal-link {
  font-size: 24rpx;
  color: #999;
}

.legal-sep {
  margin: 0 16rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* ========== 协议弹窗样式 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-container {
  width: 85%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx 32rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #999;
}

.modal-body {
  max-height: 45vh;
  padding: 16rpx 24rpx;
}

/* 协议摘要卡片 */
.agreement-summary {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-card {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
}

.summary-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
}

.summary-text {
  flex: 1;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.summary-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

/* 底部操作区 */
.modal-footer {
  padding: 20rpx 32rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
}

.checkbox-row {
  margin-bottom: 12rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.link {
  color: #FF6B35;
}

.btn-agree {
  background: #ddd;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx;
  border-radius: 40rpx;
  border: none;
  margin-top: 12rpx;
  transition: all 0.3s;
}

.btn-agree.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F60 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
}

.btn-agree::after {
  border: none;
}
