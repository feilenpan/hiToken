/* pages/index/index.wxss - 方案A 极简主义 + 内联修复 */

/* 隐私弹窗 */
.privacy-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; }
.privacy-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); }
.privacy-card { position: relative; background: #fff; border-radius: 24rpx; width: 620rpx; padding: 48rpx 40rpx 40rpx; text-align: center; box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.15); }
.privacy-title { font-size: 36rpx; font-weight: 700; color: #333; margin-bottom: 24rpx; }
.privacy-body { font-size: 28rpx; color: #666; line-height: 1.7; margin-bottom: 36rpx; text-align: left; }
.privacy-btn-link { background: transparent; border: none; color: #FF6B35; font-size: 26rpx; padding: 12rpx 0; margin-bottom: 20rpx; }
.privacy-btn-link::after { border: none; }
.privacy-btn-agree { width: 100%; height: 88rpx; line-height: 88rpx; background: linear-gradient(135deg, #FF6B35, #FF8F65); color: #fff; font-size: 32rpx; font-weight: 600; border-radius: 44rpx; border: none; }
.privacy-btn-agree::after { border: none; }

/* 页面基础 */
.page {
  background: #FAFAFA;
  height: 100vh;
  overflow: hidden;
}

.page-scroll {
  height: 100vh;
  width: 100%;
}

/* 首屏区：撑满一屏，确保历史记录被折到下方 */
.above-fold {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== 效果展示区 ========== */
.hero-section {
  position: relative;
  height: 960rpx;
  overflow: hidden;
  padding: 0 24rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.hero-img.dim {
  opacity: 0.5;
}

/* ========== 修复中覆盖层 ========== */
.repair-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 24rpx;
}

.repair-sphere {
  width: 120rpx;
  height: 120rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.sphere-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 4rpx solid transparent;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sphere-ring.r2 {
  width: 80%;
  height: 80%;
  border-top-color: #FF8F65;
  animation-direction: reverse;
  animation-duration: 1.2s;
}

.sphere-ring.r3 {
  width: 60%;
  height: 60%;
  border-top-color: #FFB088;
  animation-duration: 0.6s;
}

.sphere-core {
  font-size: 40rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.repair-text {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.repair-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 400rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35, #FF8F65);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-num {
  font-size: 22rpx;
  color: #fff;
  width: 60rpx;
  text-align: right;
}

/* 修复失败 */
.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #fff;
  text-align: center;
  padding: 0 40rpx;
  line-height: 1.5;
}

/* ========== 内容区 ========== */
.content-section {
  padding: 48rpx 40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 功能标题 */
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.section-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

/* ========== 超大 CTA 按钮 ========== */
.cta-button {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F60 100%);
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 53, 0.4);
  margin-bottom: 24rpx;
}

.cta-icon {
  font-size: 40rpx;
}

.cta-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* 次要说明 */
.secondary-text {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

/* ========== 操作按钮栏 ========== */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-change {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  color: #FF6B35;
  background: #fff;
  border: 2rpx solid #FF6B35;
  border-radius: 48rpx;
  font-weight: 600;
}

.btn-change::after { border: none; }

.btn-retry {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF6B35, #FF8F60);
  border-radius: 48rpx;
  border: none;
  font-weight: 600;
}

.btn-retry::after { border: none; }

.btn-save {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  border-radius: 48rpx;
  border: none;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.btn-save::after { border: none; }

/* ========== 底部协议入口 ========== */
.legal-links {
  text-align: center;
  padding: 32rpx 0 80rpx;
}

.legal-link {
  font-size: 24rpx;
  color: #999;
}

.legal-sep {
  margin: 0 16rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* ========== 协议弹窗样式 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-container {
  width: 85%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx 32rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #999;
}

.modal-body {
  max-height: 45vh;
  padding: 16rpx 24rpx;
}

/* 协议摘要卡片 */
.agreement-summary {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-card {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
}

.summary-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
}

.summary-text {
  flex: 1;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.summary-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

/* 底部操作区 */
.modal-footer {
  padding: 20rpx 32rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
}

.checkbox-row {
  margin-bottom: 12rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.link {
  color: #FF6B35;
}

.btn-agree {
  background: #ddd;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx;
  border-radius: 40rpx;
  border: none;
  margin-top: 12rpx;
  transition: all 0.3s;
}

.btn-agree.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F60 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
}

.btn-agree::after {
  border: none;
}

/* ============================================
   历史记录区 — 上滑暴露
   ============================================ */
.history-section {
  padding: 40rpx 40rpx 60rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #FAFAFA;
}

/* 区头 */
.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.history-view-all {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #FF6B35;
}

.history-arrow {
  font-size: 32rpx;
  line-height: 1;
}

/* ========== 横向滚动缩略图 ========== */
.history-gallery-wrap {
  margin: 0 -40rpx;
  padding: 0 40rpx;
}

.history-gallery {
  width: 100%;
  white-space: nowrap;
}

.gallery-track {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.gallery-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 160rpx;
  flex-shrink: 0;
}

.gallery-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eee;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.gallery-img {
  width: 100%;
  height: 100%;
}

.gallery-time {
  font-size: 22rpx;
  color: #999;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 空状态 ========== */
.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.empty-icon-history {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.empty-text-history {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-cta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F60);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.empty-cta-icon {
  font-size: 32rpx;
}

/* ========== 上滑提示 ========== */
.scroll-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 0;
  opacity: 0.35;
  animation: hintBounce 2s ease-in-out infinite;
}

.scroll-hint-text {
  font-size: 22rpx;
  color: #999;
}

.scroll-hint-arrow {
  font-size: 28rpx;
  color: #999;
  margin-top: 4rpx;
}

@keyframes hintBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
