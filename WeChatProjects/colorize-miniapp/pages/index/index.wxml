<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 隐私授权弹窗 -->
  <view wx:if="{{showPrivacyPopup}}" class="privacy-overlay">
    <view class="privacy-mask"></view>
    <view class="privacy-card">
      <view class="privacy-title">🔒 隐私授权</view>
      <view class="privacy-body">为了提供AI照片修复服务，需要获取你的照片信息。请阅读并同意《隐私保护政策》。</view>
      <button class="privacy-btn-link" bindtap="handleOpenPrivacyContract">查看隐私协议</button>
      <button class="privacy-btn-agree" id="agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacy">同意并继续</button>
    </view>
  </view>

  <!-- ========== 效果展示区 ========== -->
  <view class="hero-section">
    <!-- 🔴 DEBUG: 如果看到这行红字说明代码已加载 -->
    <text style="color:red;font-size:40rpx;position:absolute;top:20rpx;left:40rpx;z-index:99;background:white;padding:8rpx 16rpx;border-radius:8rpx;">🔴 HISTORY V6</text>
    <image wx:if="{{!originalImage && !repairResult}}" src="{{heroImage}}" mode="aspectFill" class="hero-img"></image>
    <image wx:elif="{{!repairResult}}" src="{{originalImage}}" mode="aspectFill" class="hero-img dim"></image>
    <image wx:else src="{{repairResult}}" mode="aspectFill" class="hero-img" show-menu-by-longpress="{{true}}"></image>

    <!-- 修复中覆盖层 -->
    <view class="repair-overlay" wx:if="{{isRepairing}}">
      <view class="repair-sphere">
        <view class="sphere-ring"></view>
        <view class="sphere-ring r2"></view>
        <view class="sphere-ring r3"></view>
        <view class="sphere-core">✨</view>
      </view>
      <text class="repair-text">AI 正在修复中…</text>
      <view class="repair-progress">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progress}}"></view>
        </view>
        <text class="progress-num">{{progress}}%</text>
      </view>
    </view>

    <!-- 修复失败 -->
    <view class="repair-overlay" wx:if="{{repairError && !isRepairing}}">
      <text class="error-icon">😅</text>
      <text class="error-text">{{repairError}}</text>
    </view>
  </view>

  <!-- ========== 内容区 ========== -->
  <view class="content-section">
    <!-- 默认状态 -->
    <block wx:if="{{!originalImage}}">
      <view class="section-title">智能修复</view>
      <view class="section-description">
        让褪色的老照片重获新生。去除折痕划痕，还原模糊细节，唤醒沉睡在相册里的旧时光。
      </view>
      <view class="cta-button" bindtap="onChooseImage">
        <text class="cta-icon">📸</text>
        <text class="cta-text">选择照片，开始修复</text>
      </view>
      <view class="secondary-text">💡 完全免费</view>
    </block>

    <!-- 修复中/有结果：操作按钮 -->
    <block wx:else>
      <view class="action-bar">
        <button class="btn-change" bindtap="onChangeImage">换一张</button>
        <button class="btn-retry" bindtap="onRetryRepair" wx:if="{{!isRepairing}}">
          🔄 重新修复
        </button>
      </view>
      <button class="btn-save" bindtap="onSaveResult" wx:if="{{repairResult && !isRepairing}}">
        💾 保存到相册
      </button>
    </block>

    <!-- 底部协议入口 -->
    <view class="legal-links">
      <text class="legal-link" bindtap="onViewPrivacy">《隐私保护政策》</text>
      <text class="legal-sep">|</text>
      <text class="legal-link" bindtap="onViewAgreement">《用户服务协议》</text>
    </view>
  </view>

  <!-- ========== 📜 历史记录区 ========== -->
  <view class="history-section">
    <view class="history-header">
      <text class="history-title">处理记录</text>
      <view class="history-view-all" bindtap="onViewAllHistory" wx:if="{{hasHistory}}">
        <text>查看全部</text>
        <text class="history-arrow">›</text>
      </view>
    </view>

    <!-- 有记录：横向滚动缩略图 -->
    <view class="history-gallery-wrap" wx:if="{{hasHistory}}">
      <scroll-view scroll-x enhanced class="history-gallery" show-scrollbar="{{false}}">
        <view class="gallery-track">
          <view
            class="gallery-item"
            wx:for="{{historyRecords}}"
            wx:key="taskId"
            bindtap="onPreviewHistory"
            data-index="{{index}}"
          >
            <view class="gallery-thumb">
              <image src="{{item.localPath}}" mode="aspectFill" class="gallery-img" lazy-load></image>
            </view>
            <text class="gallery-time">{{item.timeStr}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 无记录：空状态 -->
    <view class="history-empty" wx:else>
      <text class="empty-icon-history">🕰️</text>
      <text class="empty-text-history">还没有修复记录</text>
      <view class="empty-cta" bindtap="onChooseImage">
        <text>📸 上传第一张照片</text>
      </view>
    </view>
  </view>

  <!-- 服务协议弹窗 -->
  <view class="modal-mask" wx:if="{{showAgreementModal}}">
    <view class="modal-container">
      <view class="modal-header">
        <text class="modal-title">📋 用户服务协议</text>
        <text class="modal-subtitle">请阅读并同意以下协议后开始使用</text>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view class="agreement-summary">
          <view class="summary-card">
            <view class="summary-icon">📄</view>
            <view class="summary-text">
              <view class="summary-title">服务说明</view>
              <view class="summary-desc">本服务提供 AI 照片打分点评和 AI 照片修复功能。AI 结果由人工智能自动生成，仅供娱乐参考。目前服务完全免费。</view>
            </view>
          </view>
          <view class="summary-card">
            <view class="summary-icon">🛡️</view>
            <view class="summary-text">
              <view class="summary-title">使用规范</view>
              <view class="summary-desc">请遵守中华人民共和国法律法规。请勿上传违法违规内容或侵犯他人权益的照片。您上传的照片知识产权归您所有，处理完成后立即删除。</view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <view class="checkbox-row">
          <checkbox-group bindchange="onAgreementCheckboxChange">
            <label class="checkbox-label">
              <checkbox value="agree" checked="{{agreementChecked}}" color="#FF6B35"/>
              <text>我已阅读并同意</text>
              <text class="link" bindtap="onViewAgreement">《用户服务协议》</text>
              <text>和</text>
              <text class="link" bindtap="onViewPrivacy">《隐私保护政策》</text>
            </label>
          </checkbox-group>
        </view>
        <button 
          class="btn-agree {{agreementChecked ? 'active' : ''}}" 
          bindtap="onAgreeAgreement"
          disabled="{{!agreementChecked}}"
        >同意并开始使用</button>
      </view>
    </view>
  </view>
</view>
