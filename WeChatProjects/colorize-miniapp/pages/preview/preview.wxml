<!-- pages/preview/preview.wxml -->
<view class="page">

  <!-- ====== 默认态：未选图 ====== -->
  <block wx:if="{{!imagePath}}">
    <view class="default-container">
      <view class="hero-section">
        <view class="brand-card">
          <view class="brand-icon">📸</view>
          <text class="brand-title">时光修复</text>
          <text class="brand-desc">让褪色的老照片重获新生</text>
          <view class="brand-divider"></view>
          <text class="brand-feature">去除折痕 · 修复划痕 · 还原细节</text>
        </view>
        <view class="cta-button" bindtap="onPickImage">
          <text class="cta-icon">📸</text>
          <text class="cta-text">选择照片</text>
        </view>
        <text class="free-hint">💡 完全免费</text>
      </view>

      <!-- === 今天信息板 === -->
      <view class="info-board">
        <view class="board-date">
          <text class="board-date-num">{{todayDate}}</text>
          <text class="board-date-week">{{todayWeekday}}</text>
        </view>

        <view class="board-photos" wx:if="{{todayRecords.length > 0}}">
          <scroll-view scroll-x enhanced class="board-gallery" show-scrollbar="{{false}}">
            <view class="board-track">
              <view class="board-item" wx:for="{{todayRecords}}" wx:key="taskId" bindtap="onPreviewHistory" data-date="{{todayDate}}" data-index="{{index}}">
                <view class="board-thumb">
                  <image src="{{item.localPath}}" mode="aspectFill" class="board-thumb-img" lazy-load></image>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="board-empty" wx:else>
          <text class="board-empty-text">今天还没有修复记录</text>
          <text class="board-empty-hint" wx:if="{{previousSections.length === 0}}">选择一张照片开始吧</text>
        </view>
      </view>

      <!-- === 之前每天独立信息板 === -->
      <view class="info-board" wx:for="{{previousSections}}" wx:key="dateKey" wx:for-item="sec">
        <view class="board-prev-date">
          <text class="board-prev-date-num">{{sec.date}}</text>
          <text class="board-prev-date-week">{{sec.weekday}}</text>
        </view>
        <view class="board-photos board-photos-prev">
          <scroll-view scroll-x enhanced class="board-gallery" show-scrollbar="{{false}}">
            <view class="board-track">
              <view class="board-item" wx:for="{{sec.records}}" wx:key="taskId" wx:for-item="r" bindtap="onPreviewHistoryByDate" data-date="{{sec.dateKey}}" data-index="{{index}}">
                <view class="board-thumb">
                  <image src="{{r.localPath}}" mode="aspectFill" class="board-thumb-img" lazy-load></image>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <view style="height:12rpx; flex-shrink:0;"></view>
    </view>
  </block>

  <!-- ====== 已选图：纯修复 ====== -->
  <block wx:else>
    <view class="photo-section">
      <!-- 返回首页 -->
      <view class="back-link" bindtap="onBackHome">
        <text class="back-arrow">‹</text>
        <text>返回</text>
      </view>
      <view class="photo-container">
        <image src="{{imagePath}}" mode="aspectFit" class="photo-img" />
        <view class="photo-glow"></view>
        <text class="photo-sparkle sparkle-tl">✨</text>
        <text class="photo-sparkle sparkle-tr">✨</text>
      </view>
      <view class="repairing-overlay" wx:if="{{isRepairing}}">
        <view class="repairing-sphere">
          <view class="sphere-ring"></view><view class="sphere-ring r2"></view><view class="sphere-ring r3"></view>
          <view class="sphere-core">✨</view>
        </view>
        <text class="repairing-text">AI 正在修复中…</text>
      </view>
      <view class="repair-result" wx:if="{{repairResult && !isRepairing}}">
        <view class="result-header">
          <text class="result-icon">✨</text>
          <text class="result-title">修复完成</text>
        </view>
        <view class="result-card share-hint">
          <image src="{{repairResult}}" mode="widthFix" class="result-img" show-menu-by-longpress="{{true}}"></image>
          <view class="result-label"><text class="result-hint">长按图片可分享或保存</text></view>
        </view>
      </view>
      <view class="repair-error" wx:if="{{repairError && !isRepairing}}">
        <text class="error-icon">😅</text>
        <text class="error-text">{{repairError}}</text>
        <button class="btn-retry" bindtap="onRetryRepair">🔄 重试</button>
      </view>
    </view>
    <view class="fixed-bottom-bar">
      <button class="btn-change" bindtap="onChangeImage">换一张</button>
      <button class="btn-start" bindtap="onRetryRepair">✨ AI 修复</button>
    </view>
  </block>

</view>
