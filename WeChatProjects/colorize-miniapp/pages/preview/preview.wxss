/* pages/preview/preview.wxss - 默认态 + 选图即修 */

page {
  background: #FAFAFA;
  height: 100vh;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 默认态 ===== */
.default-scroll {
  flex: 1;
  height: 100%;
}

.hero-section {
  height: 580rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 120rpx 48rpx 0;
}

/* 品牌卡片 */
.brand-card {
  width: 100%;
  max-width: 520rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 36rpx rgba(0,0,0,0.06);
  animation: brandFloat 4s ease-in-out infinite;
  margin-bottom: 32rpx;
}

@keyframes brandFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.brand-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
  display: block;
  animation: iconPulse 3s ease-in-out infinite;
}

@keyframes iconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.brand-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.brand-desc {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.brand-divider {
  width: 80rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #FF6B35, transparent);
  margin: 0 auto 14rpx;
  border-radius: 2rpx;
}

.brand-feature {
  font-size: 24rpx;
  color: #aaa;
  letter-spacing: 2rpx;
}

/* CTA */
.cta-button {
  width: 480rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F60 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 53, 0.35);
  margin-bottom: 12rpx;
}
.cta-button:active { transform: scale(0.97); opacity: 0.9; }

.cta-icon { font-size: 36rpx; }

.cta-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.free-hint {
  font-size: 24rpx;
  color: #aaa;
}

/* ===== 已选图状态 ===== */
.back-link {
  width: 100%;
  padding: 16rpx 32rpx 8rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: #999;
}
.back-arrow { font-size: 40rpx; line-height: 1; margin-top: -2rpx; }

.photo-section {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  min-height: 0;
  overflow-y: auto;
}

.photo-container {
  position: relative;
  z-index: 2;
  flex: 1;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.1);
  animation: photoFloat 4s ease-in-out infinite;
  overflow: hidden;
  min-height: 200rpx;
}

@keyframes photoFloat {
  0%, 100% { 
    transform: translateY(0) rotate(0deg); 
    box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.1);
  }
  25% { 
    transform: translateY(-22rpx) rotate(0.5deg); 
    box-shadow: 0 24rpx 56rpx rgba(0,0,0,0.12);
  }
  50% { 
    transform: translateY(-10rpx) rotate(0deg); 
    box-shadow: 0 16rpx 44rpx rgba(0,0,0,0.1);
  }
  75% { 
    transform: translateY(-28rpx) rotate(-0.3deg); 
    box-shadow: 0 28rpx 60rpx rgba(0,0,0,0.14);
  }
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-glow {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 70%;
  height: 30rpx;
  background: radial-gradient(ellipse, rgba(255,107,53,0.12), transparent);
  border-radius: 50%;
  filter: blur(10rpx);
  z-index: 1;
  animation: glowPulse 4s ease-in-out infinite;
}

.photo-sparkle {
  position: absolute;
  font-size: 28rpx;
  color: #FF6B35;
  opacity: 0;
  z-index: 3;
  pointer-events: none;
}

/* 粒子 */
.photo-sparkle {
  position: absolute;
  font-size: 28rpx;
  color: #FF6B35;
  opacity: 0;
  z-index: 3;
  pointer-events: none;
}
.sparkle-tl { top: 16rpx; left: 36rpx; animation: sparkleFloat 3s ease-in-out 0s infinite; }
.sparkle-tr { top: 32rpx; right: 44rpx; animation: sparkleFloat 3s ease-in-out 0.8s infinite; }

@keyframes sparkleFloat {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.5); }
  30% { opacity: 0.6; transform: translateY(-16rpx) scale(1); }
  60% { opacity: 0.2; transform: translateY(-24rpx) scale(0.7); }
}
.repairing-overlay {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 0 20rpx;
}
.repairing-sphere {
  width: 120rpx; height: 120rpx;
  position: relative;
  display: flex; align-items: center; justify-content: center;
}
.repairing-text {
  font-size: 28rpx;
  color: #888;
  font-weight: 500;
}

/* 复用 score 页的 sphere-ring 动画 */
.sphere-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 4rpx solid transparent;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.sphere-ring.r2 {
  width: 80%;
  height: 80%;
  border-top-color: #FF8F65;
  animation-direction: reverse;
  animation-duration: 1.2s;
}
.sphere-ring.r3 {
  width: 60%;
  height: 60%;
  border-top-color: #FFB088;
  animation-duration: 0.6s;
}
.sphere-core {
  font-size: 40rpx;
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

/* ===== 修复结果 ===== */
.repair-result {
  width: 100%;
  margin-top: 24rpx;
  animation: slideUpIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes slideUpIn {
  0% { opacity: 0; transform: translateY(40rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.result-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 8rpx 16rpx;
}
.result-icon { font-size: 32rpx; }
.result-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }

.result-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  padding: 20rpx 24rpx 24rpx;
}
.result-card.share-hint .result-img {
  animation: shareBreathe 2.5s ease-in-out infinite;
}
@keyframes shareBreathe {
  0%, 100% { transform: translateY(0); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }
  50% { transform: translateY(-10rpx); box-shadow: 0 12rpx 36rpx rgba(255,107,53,0.2); }
}
.result-img {
  width: 100%;
  border-radius: 16rpx;
  display: block;
}
.result-label {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: #FFF5F0;
  border-radius: 16rpx;
}
.result-hint {
  font-size: 24rpx;
  color: #FF8F60;
  animation: hintPulse 2s ease-in-out infinite;
}
@keyframes hintPulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* ===== 修复失败 ===== */
.repair-error {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 0;
}
.error-icon { font-size: 60rpx; }
.error-text { font-size: 26rpx; color: #999; }
.btn-retry {
  width: 240rpx; height: 72rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F60);
  border-radius: 36rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 26rpx; font-weight: 600;
  border: none;
  margin-top: 10rpx;
}
.btn-retry::after { border: none; }

/* 底部留白 */
.bottom-spacer {
  height: 200rpx;
  flex-shrink: 0;
}

/* ===== 固定底部按钮栏 ===== */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(250,250,250,0.98) 80%, rgba(250,250,250,0) 100%);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}

.btn-change {
  flex: 1;
  height: 84rpx;
  background: #F0F0F0;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-start {
  flex: 2;
  height: 84rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F60);
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(255,107,53,0.3);
}

.btn-change::after, .btn-start::after { border: none; }
.btn-start:active { transform: scale(0.97); }

/* ============================================
   信息板
   ============================================ */
.info-board {
  margin: 120rpx 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
  overflow: hidden;
}

/* 日期区 */
.board-date {
  padding: 36rpx 40rpx 24rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.board-date-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1;
}
.board-date-week {
  font-size: 28rpx;
  color: #999;
}

.board-divider {
  height: 1rpx;
  background: #f5f5f5;
  margin: 0 40rpx;
}

/* 当天照片横滑 */
.board-photos {
  padding: 28rpx 0 20rpx;
}
.board-gallery {
  width: 100%;
  white-space: nowrap;
}
.board-track {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 40rpx;
}
.board-item {
  width: 180rpx;
  flex-shrink: 0;
}
.board-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}
.board-thumb-img {
  width: 100%;
  height: 100%;
}

/* 空状态 */
.board-empty {
  padding: 48rpx 40rpx 24rpx;
  text-align: center;
}
.board-empty-text {
  display: block;
  font-size: 26rpx;
  color: #bbb;
}
.board-empty-hint {
  display: block;
  font-size: 24rpx;
  color: #ddd;
  margin-top: 8rpx;
}
