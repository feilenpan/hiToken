/* pages/preview/preview.wxss - 照片撑满 + 固定按钮 */

page {
  background: #FAFAFA;
  height: 100vh;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 照片区（flex:1 撑满剩余空间，可滚动） ===== */
.photo-section {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  min-height: 0;
  overflow-y: auto;
}

.photo-container {
  position: relative;
  z-index: 2;
  flex: 1;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.1);
  animation: photoFloat 4s ease-in-out infinite;
  overflow: hidden;
  min-height: 200rpx;
}

@keyframes photoFloat {
  0%, 100% { 
    transform: translateY(0) rotate(0deg); 
    box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.1);
  }
  25% { 
    transform: translateY(-22rpx) rotate(0.5deg); 
    box-shadow: 0 24rpx 56rpx rgba(0,0,0,0.12);
  }
  50% { 
    transform: translateY(-10rpx) rotate(0deg); 
    box-shadow: 0 16rpx 44rpx rgba(0,0,0,0.1);
  }
  75% { 
    transform: translateY(-28rpx) rotate(-0.3deg); 
    box-shadow: 0 28rpx 60rpx rgba(0,0,0,0.14);
  }
}

.photo-img {
  width: 100%;
  height: 100%;
}

/* 光晕 */
.photo-glow {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 70%;
  height: 30rpx;
  background: radial-gradient(ellipse, rgba(255,107,53,0.12), transparent);
  border-radius: 50%;
  filter: blur(10rpx);
  z-index: 1;
  animation: glowPulse 4s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.4; transform: translateX(-50%) scale(1); }
  50% { opacity: 0.9; transform: translateX(-50%) scale(1.15); }
}

/* 粒子 */
.photo-sparkle {
  position: absolute;
  font-size: 28rpx;
  color: #FF6B35;
  opacity: 0;
  z-index: 3;
  pointer-events: none;
}
.sparkle-tl { top: 16rpx; left: 36rpx; animation: sparkleFloat 3s ease-in-out 0s infinite; }
.sparkle-tr { top: 32rpx; right: 44rpx; animation: sparkleFloat 3s ease-in-out 0.8s infinite; }

@keyframes sparkleFloat {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.5); }
  30% { opacity: 0.6; transform: translateY(-16rpx) scale(1); }
  60% { opacity: 0.2; transform: translateY(-24rpx) scale(0.7); }
}

/* 档案信息 + 模糊警告 */
.photo-meta {
  width: 100%;
  padding: 12rpx 8rpx 0;
  z-index: 2;
  position: relative;
}

.file-info {
  text-align: center;
  padding: 8rpx 0 4rpx;
}
.file-name { font-size: 26rpx; color: #555; display: block; }
.file-size { font-size: 22rpx; color: #aaa; }

.blur-warning {
  margin-top: 8rpx;
  padding: 12rpx 20rpx;
  background: #FFF9E6;
  border-radius: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #B8860B;
}

/* ===== 修复中动画 ===== */
.repairing-overlay {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 0 20rpx;
}
.repairing-sphere {
  width: 120rpx; height: 120rpx;
  position: relative;
  display: flex; align-items: center; justify-content: center;
}
.repairing-text {
  font-size: 28rpx;
  color: #888;
  font-weight: 500;
}

/* ===== 修复结果 ===== */
.repair-result {
  width: 100%;
  margin-top: 24rpx;
  animation: slideUpIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes slideUpIn {
  0% { opacity: 0; transform: translateY(40rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.result-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 8rpx 16rpx;
}
.result-icon { font-size: 32rpx; }
.result-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }

.result-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  padding: 20rpx 24rpx 24rpx;
}
.result-card.share-hint .result-img {
  animation: shareBreathe 2.5s ease-in-out infinite;
}
@keyframes shareBreathe {
  0%, 100% { transform: translateY(0); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }
  50% { transform: translateY(-10rpx); box-shadow: 0 12rpx 36rpx rgba(255,107,53,0.2); }
}
.result-img {
  width: 100%;
  border-radius: 16rpx;
  display: block;
}
.result-label {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: #FFF5F0;
  border-radius: 16rpx;
}
.result-hint {
  font-size: 24rpx;
  color: #FF8F60;
  animation: hintPulse 2s ease-in-out infinite;
}
@keyframes hintPulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* ===== 修复失败 ===== */
.repair-error {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 0;
}
.error-icon { font-size: 60rpx; }
.error-text { font-size: 26rpx; color: #999; }
.btn-retry {
  width: 240rpx; height: 72rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F60);
  border-radius: 36rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 26rpx; font-weight: 600;
  border: none;
  margin-top: 10rpx;
}
.btn-retry::after { border: none; }

/* 底部留白 */
.bottom-spacer {
  height: 200rpx;
  flex-shrink: 0;
}

/* ===== 固定底部按钮栏 ===== */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(250,250,250,0.98) 80%, rgba(250,250,250,0) 100%);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}

.btn-change {
  flex: 1;
  height: 84rpx;
  background: #F0F0F0;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-start {
  flex: 2;
  height: 84rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F60);
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(255,107,53,0.3);
}

.btn-change::after, .btn-start::after { border: none; }
.btn-start:active { transform: scale(0.97); }
