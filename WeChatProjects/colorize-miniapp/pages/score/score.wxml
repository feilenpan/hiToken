<!-- pages/score/score.wxml - AI 照片品鉴 -->
<view class="page">
  <!-- 隐私授权弹窗 -->
  <view wx:if="{{showPrivacyPopup}}" class="privacy-overlay">
    <view class="privacy-mask"></view>
    <view class="privacy-card">
      <view class="privacy-title">🔒 隐私授权</view>
      <view class="privacy-body">为了提供AI照片评估和修复服务，需要获取你的照片信息。请阅读并同意《隐私保护政策》。</view>
      <button class="privacy-btn-link" bindtap="handleOpenPrivacyContract">查看隐私协议</button>
      <button class="privacy-btn-agree" id="agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacy">同意并继续</button>
    </view>
  </view>

  <!-- 空白状态 -->
  <view class="empty-state" wx:if="{{!imagePath && !isUploading}}">
    <view class="floating-words">
      <text class="fw fw-emoji fe1">🌸</text>
      <text class="fw fw-emoji fe2">👏</text>
      <text class="fw fw-emoji fe3">💕</text>
      <text class="fw fw-emoji fe4">✨</text>
      <text class="fw fw-emoji fe5">🎉</text>
      <text class="fw fw-emoji fe6">🔥</text>
      <text class="fw fw-emoji fe7">🌟</text>
      <text class="fw fw-emoji fe8">💫</text>
      <text class="fw fw-praise fp1">妙哉！</text>
      <text class="fw fw-praise fp2">好诗~</text>
      <text class="fw fw-praise fp3">绝了！</text>
      <text class="fw fw-praise fp4">雅致绝伦</text>
      <text class="fw fw-praise fp5">有韵味</text>
      <text class="fw fw-praise fp6">写得好</text>
      <text class="fw fw-praise fp7">喜欢这首</text>
      <text class="fw fw-praise fp8">千古名句！</text>
      <text class="fw fw-heart fh1">💕</text>
      <text class="fw fw-heart fh2">❤️</text>
      <text class="fw fw-heart fh3">💗</text>
      <text class="fw fw-heart fh4">💖</text>
    </view>
    <text class="empty-desc">选一位大师，为您的照片题诗品鉴</text>
    <!-- 点评师选择器 — 横向滑动人物卡片 -->
    <scroll-view class="reviewer-scroll" scroll-x enhanced show-scrollbar="{{false}}" enable-flex>
      <view class="reviewer-cards">
        <view class="reviewer-card {{selectedReviewer === item.id ? 'card-active' : ''}}" 
              wx:for="{{reviewers}}" wx:key="id" 
              bindtap="onSelectReviewer" data-id="{{item.id}}">
          <view class="card-avatar card-bg-{{item.id}}">
            <text class="card-emoji">{{item.emoji}}</text>
          </view>
          <text class="card-name">{{item.name}}</text>
          <text class="card-title">{{item.shortTitle}}</text>
        </view>
        <!-- 随缘卡 — 视觉区分 -->
        <view class="reviewer-card random-card {{selectedReviewer === '' ? 'card-active' : ''}}" 
              bindtap="onSelectReviewer" data-id="">
          <view class="card-avatar card-bg-random">
            <text class="card-emoji">🎲</text>
          </view>
          <text class="card-name">随缘</text>
          <text class="card-title">随机邂逅</text>
        </view>
      </view>
    </scroll-view>
    <view class="btn-circle-wrap" bindtap="onChooseImage">
      <view class="btn-circle-outer"></view>
      <view class="btn-circle-ring"></view>
      <view class="btn-circle-ring"></view>
      <view class="btn-circle-core">
        <image class="btn-circle-icon" src="/images/btn-camera.png" mode="aspectFit"></image>
      </view>
    </view>
    <text class="quota-hint" wx:if="{{quota}}">今日剩余：点评 {{quota.evaluate.remaining}} 次 · 处理 {{quota.process.remaining}} 次</text>
  </view>

  <!-- 照片区域 -->
  <view class="photo-section" wx:if="{{imagePath}}">
    <view class="photo-frame {{isUploading ? '' : 'floating'}}">
      <image src="{{imagePath}}" mode="widthFix" class="photo-img"></image>
    </view>
    <view class="photo-shadow" wx:if="{{!isUploading}}"></view>
    
    <!-- 分析中动画 -->
    <view class="analyzing-overlay" wx:if="{{showAnalyzing}}">
      <view class="analyzing-sphere">
        <view class="sphere-ring"></view>
        <view class="sphere-ring r2"></view>
        <view class="sphere-ring r3"></view>
        <view class="sphere-core">✨</view>
      </view>
      <text class="analyzing-text">{{analyzingText}}</text>
      <view class="analyzing-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </view>

  <!-- 品鉴结果 -->
  <view class="eval-section" wx:if="{{evaluation && !showAnalyzing}}">
    <!-- 印章落款（代替数字分数） -->
    <view class="stamp-seal {{showScore ? 'stamp-show' : ''}}">
      <view class="stamp-ring">
        <view class="stamp-inner">
          <text class="stamp-name">{{evaluation.reviewer || '时光点评师'}}</text>
          <text class="stamp-label">{{evaluation.stampLevel || '品鉴'}}</text>
        </view>
      </view>
    </view>

    <!-- 地点标签 -->
    <view class="eval-location" wx:if="{{evaluation.location}}">
      <text class="location-icon">📍</text>
      <text class="location-text">{{evaluation.location}}</text>
    </view>

    <!-- 地点故事 -->
    <view class="location-story" wx:if="{{evaluation.location_story}}">
      <text class="story-quote">「</text>
      <text class="story-text">{{evaluation.location_story}}</text>
      <text class="story-quote">」</text>
    </view>

    <!-- 品鉴评语 -->
    <view class="eval-text-card">
      <view class="eval-header">
        <text class="eval-badge-emoji">{{evaluation.reviewer_emoji || '🍶'}}</text>
        <text class="eval-title">{{evaluation.reviewer || '时光点评师'}} 品鉴</text>
      </view>
      <view class="eval-body">
        <text class="eval-text">{{typedText}}</text>
        <text class="cursor" wx:if="{{typingCursor}}">|</text>
      </view>
      <!-- 诗词 -->
      <view class="eval-poem" wx:if="{{evaluation.poem}}">
        <view class="poem-lines">
          <text class="poem-line" wx:for="{{evaluation.poemLines}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="poem-author">—— {{evaluation.reviewer}}</view>
      </view>
    </view>

    <!-- 修图建议 -->
    <view class="suggestions-section" wx:if="{{evaluation.suggestions && evaluation.suggestions.length > 0}}">
      <view class="suggestions-header">
        <text class="suggestions-icon">✨</text>
        <text class="suggestions-title">不妨试试</text>
      </view>
      <view class="suggestions-list">
        <view class="suggestion-chip {{item.loading ? 'chip-loading' : ''}} {{item.clicked ? 'chip-clicked' : ''}}" 
              wx:for="{{evaluation.suggestions}}" wx:key="label" 
              bindtap="onSuggestionTap" data-suggestion="{{item}}" data-index="{{index}}">
          <text class="suggestion-type">{{item.type === 'add' ? '➕' : item.type === 'remove' ? '❌' : item.type === 'modify' ? '🔄' : item.type === 'style' ? '🖌️' : item.type === 'color' ? '🌈' : item.type === 'expression' ? '😊' : item.type === 'background' ? '🎨' : '✂️'}}</text>
          <text class="suggestion-label">{{item.loading ? '处理中…' : item.label}}</text>
          <text class="suggestion-spinner" wx:if="{{item.loading}}">⏳</text>
        </view>
      </view>
    </view>

    <!-- 编辑结果 -->
    <view class="edit-results-list" wx:if="{{editResults.length > 0}}">
      <view class="edit-result {{item.loading ? '' : 'result-done'}}" wx:for="{{editResults}}" wx:key="id">
        <view class="edit-result-loading" wx:if="{{item.loading}}">
          <view class="result-loading-sphere">
            <view class="sphere-ring"></view>
            <view class="sphere-ring r2"></view>
            <view class="sphere-core">✨</view>
          </view>
          <text class="result-loading-text">正在按「{{item.label}}」编辑…</text>
        </view>
        <view class="edit-result-done" wx:elif="{{item.success}}">
          <view class="edit-result-header">
            <text class="edit-result-icon">✨</text>
            <text class="edit-result-title">编辑后效果</text>
          </view>
          <view class="edit-result-card share-hint">
            <image src="{{item.result}}" mode="widthFix" class="edit-result-img" show-menu-by-longpress="{{true}}"></image>
            <view class="edit-result-label">
              <text class="edit-result-prompt">「{{item.prompt}}」</text>
              <text class="edit-result-hint">长按分享</text>
            </view>
          </view>
        </view>
        <view class="edit-result-error" wx:else>
          <text class="edit-result-icon">😅</text>
          <text>{{item.error || '编辑失败'}}</text>
        </view>
      </view>
    </view>

    <!-- 标签 -->
    <view class="eval-tags" wx:if="{{evaluation.tags.length > 0}}">
      <view class="eval-tag" wx:for="{{evaluation.tags}}" wx:key="*this">{{item}}</view>
    </view>

    <!-- 金句 -->
    <view class="eval-quote" wx:if="{{evaluation.quote}}">
      <text>🌸 {{evaluation.quote}}</text>
    </view>

    <!-- 低分 CTA -->
    <view class="cta-restore" wx:if="{{showCTA}}">
      <text class="cta-text">这位点评师觉得照片需要修复，试试让它重获新生？</text>
      <button class="btn-cta" bindtap="onRepairNow">✨ 一键修复</button>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="action-bar" wx:if="{{evaluation && !showAnalyzing}}">
    <button class="btn-retry full" bindtap="onRetry">
      <text>🔄 换一张</text>
    </button>
  </view>
</view>
